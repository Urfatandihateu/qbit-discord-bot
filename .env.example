# qBittorrent Web UI
QBIT_HOST=http://192.168.0.2:8080
QBIT_USER=admin
QBIT_PASS=your_password_here

# Discord incoming webhook URL
# Create one in: Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# How often to poll qBittorrent (seconds, 10-15 recommended)
POLL_INTERVAL=12
